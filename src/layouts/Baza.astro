---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { cale } from '../lib/cale';

type Props = {
  titlu: string;
  descriere?: string;
};

const {
  titlu,
  descriere = 'Prăjitorie de cafea de specialitate din Brașov. Loturi mici, prăjite marți și vineri, ambalate în pungi de 250 g.',
} = Astro.props;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={cale('/favicon.svg')} type="image/svg+xml" />
    <title>{titlu}</title>
    <meta name="description" content={descriere} />
    <meta property="og:title" content={titlu} />
    <meta property="og:description" content={descriere} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f4efe4" />
    <meta name="color-scheme" content="light" />
  </head>
  <body>
    <a href="#continut" class="skip">Sari la conținut</a>
    <Header />
    <main id="continut">
      <slot />
    </main>
    <Footer />

    <style>
      .skip {
        position: absolute;
        left: 0.75rem;
        top: -4rem;
        z-index: 100;
        background: var(--color-ink);
        color: var(--color-paper);
        padding: 0.7rem 1.1rem;
        border-radius: 8px;
        font-size: 0.875rem;
        transition: top 160ms var(--ease-out-soft);
      }
      .skip:focus {
        top: 0.75rem;
      }
    </style>
  </body>
</html>
