---
import Marca from './Marca.astro';
import CosIndicator from './CosIndicator';
import Cauta from './Cauta';
import { imaginiPungi } from '../lib/pungi';
import { cafele, PROFILE, ultimaPrajire, dataLunga } from '../data/cafele';
import { toateAltele } from '../data/altele';
import { cale } from '../lib/cale';

const imagini = await imaginiPungi([88, 176]);

// Meniul „Cafea" se deschide pe cele trei axe după care aleg oamenii cafeaua.
const meniuCafea = [
  {
    titlu: 'După gust',
    linkuri: (['fructat', 'echilibrat', 'intens'] as const).map((p) => ({
      href: `/cafea?profil=${p}`,
      text: PROFILE[p].titlu,
    })),
  },
  {
    titlu: 'După metodă',
    linkuri: [
      { href: '/cafea?pentru=filtru', text: 'Pentru filtru' },
      { href: '/cafea?pentru=espresso', text: 'Pentru espresso' },
      { href: '/ghid', text: 'Ghid de preparare' },
    ],
  },
  {
    titlu: 'Altfel',
    linkuri: [
      { href: '/cafea?proces=Anaerob', text: 'Loturi experimentale' },
      { href: '/cafea?proces=Sugarcane+EA', text: 'Decofeinizată' },
      { href: '/pachete', text: 'Pachete și cadouri' },
      { href: '/promotii', text: 'Loturi la reducere' },
    ],
  },
];

const linkuri = [
  { href: '/cafea', text: 'Cafea boabe', meniu: true },
  { href: '/pachete', text: 'Pachete și cadouri' },
  { href: '/accesorii', text: 'Accesorii' },
  { href: '/abonament', text: 'Abonament' },
  { href: '/prajitoria', text: 'Prăjitoria' },
  { href: '/ghid', text: 'Ghid' },
  { href: '/contact', text: 'Contact' },
];

const caleCurenta = Astro.url.pathname;
/** Comparăm cu calea prefixată, ca `activ` să meargă și sub un base path. */
const activ = (href: string) =>
  caleCurenta === cale(href) || caleCurenta.startsWith(`${cale(href)}/`);
const prajire = dataLunga(ultimaPrajire());

// Reducerea cea mai mare, ca să o putem striga în meniu.
const reducereMax = Math.max(
  ...cafele
    .filter((c) => c.pretVechi)
    .map((c) => Math.round((1 - c.pret250 / c.pretVechi!) * 100)),
  ...toateAltele
    .filter((p) => p.pretVechi)
    .map((p) => Math.round((1 - p.pret / p.pretVechi!) * 100)),
);
---

<div class="anunt">
  <div class="shell anunt-rand">
    <span class="anunt-proaspat">
      <span class="punct" aria-hidden="true"></span>
      Prăjit {prajire}
    </span>
    <span class="separator" aria-hidden="true">·</span>
    <span>Livrare gratuită peste 150 lei</span>
    <span class="separator" aria-hidden="true">·</span>
    <span>Expediem în 24 h</span>
    <a href={cale('/promotii')} class="anunt-oferta">Reduceri până la −{reducereMax}%</a>
  </div>
</div>

<header class="cap" data-cap>
  <!-- Rândul 1: marcă, căutare, telefon, coș -->
  <div class="cap-sus">
    <div class="shell cap-rand">
      <a href={cale('/')} class="marca-link" aria-label="COTĂ, prima pagină">
        <Marca />
      </a>

      <div class="cap-cautare">
        <Cauta cafele={cafele} imagini={imagini} client:load />
      </div>

      <div class="cap-actiuni">
        <a class="cap-telefon" href="tel:+40700000000">
          <svg viewBox="0 0 20 20" aria-hidden="true" width="17" height="17">
            <path
              d="M4.5 3h3l1.5 3.6-2 1.3a10.5 10.5 0 0 0 5.1 5.1l1.3-2L17 12.5v3a1.5 1.5 0 0 1-1.7 1.5A13.5 13.5 0 0 1 3 4.7 1.5 1.5 0 0 1 4.5 3Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linejoin="round"></path>
          </svg>
          <span>0700 000 000</span>
        </a>
        <CosIndicator client:load />
        <button
          type="button"
          class="buton-meniu"
          aria-expanded="false"
          aria-controls="meniu-mobil"
          data-meniu
        >
          <span class="sr">Meniu</span>
          <span class="bare" aria-hidden="true"><i></i><i></i><i></i></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Rândul 2: bara de categorii -->
  <nav class="cap-categorii" aria-label="Categorii">
    <div class="shell cat-rand">
      {
        linkuri.map((l) =>
          l.meniu ? (
            <div class="cat-grup">
              <a
                href={cale(l.href)}
                class:list={['cat-link', { activ: activ(l.href) }]}
                aria-current={activ(l.href) ? 'page' : undefined}
              >
                {l.text}
                <svg viewBox="0 0 10 6" aria-hidden="true" class="cat-sageata">
                  <path
                    d="M1 1.2 5 4.8 9 1.2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                  />
                </svg>
              </a>
              <div class="cat-panou">
                <div class="shell cat-panou-grila">
                  {meniuCafea.map((col) => (
                    <div>
                      <p class="field-label">{col.titlu}</p>
                      <ul>
                        {col.linkuri.map((sub) => (
                          <li>
                            <a href={cale(sub.href)}>{sub.text}</a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                  <div class="cat-panou-nota">
                    <p class="field-label">Pe raft acum</p>
                    <p class="cat-panou-cifra">{cafele.length} loturi</p>
                    <p class="cat-panou-text">
                      Toate prăjite {prajire}, în pungi de 250 g cu supapă.
                    </p>
                    <a href={cale('/cafea')} class="link-rule">Vezi tot catalogul</a>
                  </div>
                </div>
              </div>
            </div>
          ) : (
            <a
              href={cale(l.href)}
              class:list={['cat-link', { activ: activ(l.href) }]}
              aria-current={activ(l.href) ? 'page' : undefined}
            >
              {l.text}
            </a>
          ),
        )
      }
      <span class="cat-spatiu"></span>
      <a href={cale('/promotii')} class="cat-oferta">
        <span class="cat-oferta-procent">−{reducereMax}%</span>
        Reduceri
      </a>
    </div>
  </nav>

  <nav id="meniu-mobil" class="meniu-mobil" aria-label="Principal, mobil" hidden>
    <div class="shell">
      <div class="mobil-cautare">
        <Cauta cafele={cafele} imagini={imagini} client:load />
      </div>
      {
        linkuri.map((l) => (
          <a href={cale(l.href)} class:list={['mobil-link', { activ: activ(l.href) }]}>
            {l.text}
          </a>
        ))
      }
      <a href={cale('/promotii')} class="mobil-link mobil-accent">Reduceri</a>
      <p class="field-label mobil-titlu">După gust</p>
      {
        (['fructat', 'echilibrat', 'intens'] as const).map((p) => (
          <a href={cale(`/cafea?profil=${p}`)} class="mobil-link mobil-sub">
            {PROFILE[p].titlu}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  // Înălțimea reală a headerului lipit sus. `--header-h` acoperă doar rândul cu
  // marca; bara de categorii se adaugă peste, iar elementele sticky din pagină
  // au nevoie de totalul real ca să nu ajungă sub el.
  const cap = document.querySelector<HTMLElement>('[data-cap]');
  const masoaraCap = () => {
    if (!cap) return;
    document.documentElement.style.setProperty('--cap-h', `${Math.round(cap.offsetHeight)}px`);
  };
  masoaraCap();
  window.addEventListener('resize', masoaraCap);
  if ('ResizeObserver' in window && cap) new ResizeObserver(masoaraCap).observe(cap);

  const buton = document.querySelector<HTMLButtonElement>('[data-meniu]');
  const meniu = document.getElementById('meniu-mobil');

  buton?.addEventListener('click', () => {
    const deschis = buton.getAttribute('aria-expanded') === 'true';
    buton.setAttribute('aria-expanded', String(!deschis));
    if (meniu) meniu.hidden = deschis;
    document.documentElement.classList.toggle('meniu-deschis', !deschis);
  });

  // Escape închide meniul
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && buton?.getAttribute('aria-expanded') === 'true') {
      buton.click();
      buton.focus();
    }
  });
</script>

<style>
  .anunt {
    background: var(--color-ink);
    color: color-mix(in srgb, var(--color-paper) 76%, transparent);
    font-size: 0.75rem;
  }
  .anunt-rand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-block: 0.55rem;
  }
  .separator {
    opacity: 0.32;
  }
  .anunt-proaspat {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-crema);
    font-weight: 600;
  }
  /* Punctul care pulsează: semnalul de „am prăjit acum". */
  .punct {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #7bbd8a;
    box-shadow: 0 0 0 0 rgb(123 189 138 / 0.7);
    animation: puls 2.4s ease-out infinite;
  }
  @keyframes puls {
    0% {
      box-shadow: 0 0 0 0 rgb(123 189 138 / 0.65);
    }
    70%,
    100% {
      box-shadow: 0 0 0 7px rgb(123 189 138 / 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .punct {
      animation: none;
    }
  }
  .anunt-oferta {
    margin-left: auto;
    color: var(--color-crema);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
    border-bottom: 1px solid color-mix(in srgb, var(--color-crema) 40%, transparent);
    padding-bottom: 1px;
  }
  .anunt-oferta:hover {
    color: #fff;
    border-bottom-color: currentColor;
  }
  @media (max-width: 860px) {
    .anunt-rand > .separator,
    .anunt-rand > span:not(.anunt-proaspat) {
      display: none;
    }
  }

  .cap {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-rule);
  }
  .cap-rand {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    height: var(--header-h);
  }
  .marca-link {
    text-decoration: none;
    flex: none;
  }

  .cap-cautare {
    flex: 1 1 auto;
    min-width: 0;
    display: none;
  }
  @media (min-width: 860px) {
    .cap-cautare {
      display: block;
      max-width: 34rem;
    }
  }

  .cap-actiuni {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.6vw, 1.1rem);
    flex: none;
    margin-left: auto;
  }
  .cap-telefon {
    display: none;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    font-size: 0.875rem;
    white-space: nowrap;
  }
  .cap-telefon:hover {
    color: var(--color-ink);
  }
  @media (min-width: 1120px) {
    .cap-telefon {
      display: inline-flex;
    }
  }

  /* ── Bara de categorii ─────────────────────────────────────────── */
  .cap-categorii {
    display: none;
    position: relative;
    border-top: 1px solid var(--color-rule);
    background: var(--color-paper-raised);
  }
  @media (min-width: 1080px) {
    .cap-categorii {
      display: block;
    }
  }
  .cat-rand {
    display: flex;
    align-items: stretch;
    gap: clamp(0.65rem, 1.5vw, 1.4rem);
  }
  .cat-spatiu {
    flex: 1;
  }
  .cat-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.8rem 0;
    color: var(--color-ink-muted);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    border-bottom: 2px solid transparent;
    transition:
      color 160ms var(--ease-out-soft),
      border-color 160ms var(--ease-out-soft);
    white-space: nowrap;
  }
  .cat-link:hover {
    color: var(--color-ink);
  }
  .cat-link.activ {
    color: var(--color-ink);
    border-bottom-color: var(--color-ink);
  }
  /* Evidențierea din meniu: singurul element plin de culoare din navigație. */
  .cat-oferta {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.7rem 0.4rem 0.45rem;
    border-radius: 999px;
    background: var(--color-accent-slab);
    border: 1px solid color-mix(in srgb, var(--color-accent) 26%, transparent);
    color: var(--color-accent-dark);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    transition:
      background-color 160ms var(--ease-out-soft),
      border-color 160ms var(--ease-out-soft);
  }
  .cat-oferta:hover {
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-accent-slab));
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
  }
  .cat-oferta-procent {
    display: inline-block;
    padding: 0.15rem 0.4rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .cat-sageata {
    width: 9px;
    height: 6px;
    transition: transform 180ms var(--ease-out-soft);
  }

  /* Panoul se agață de bara de categorii, nu de link — altfel un link din
     marginea stângă îl scoate din ecran. */
  .cat-panou {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background: var(--color-paper);
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    box-shadow: 0 18px 32px -18px rgb(23 20 15 / 0.28);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 160ms var(--ease-out-soft),
      visibility 160ms;
  }
  .cat-grup:hover .cat-panou,
  .cat-grup:focus-within .cat-panou {
    opacity: 1;
    visibility: visible;
  }
  .cat-grup:hover .cat-sageata,
  .cat-grup:focus-within .cat-sageata {
    transform: rotate(180deg);
  }
  .cat-panou-grila {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
  }
  .cat-panou-grila ul {
    list-style: none;
    margin: 0.7rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .cat-panou-grila a {
    color: var(--color-ink);
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .cat-panou-grila a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cat-panou-nota {
    padding-left: clamp(1.5rem, 3vw, 2.5rem);
    border-left: 1px solid var(--color-rule);
  }
  .cat-panou-cifra {
    margin: 0.6rem 0 0;
    font-size: 1.5rem;
  }
  .cat-panou-text {
    margin: 0.3rem 0 0.9rem;
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    max-width: 30ch;
  }

  /* ── Meniu mobil ──────────────────────────────────────────────── */
  .buton-meniu {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    color: var(--color-ink);
  }
  @media (min-width: 1080px) {
    .buton-meniu {
      display: none;
    }
  }
  .bare {
    display: grid;
    gap: 4px;
    width: 1.05rem;
  }
  .bare i {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition:
      transform 200ms var(--ease-out-soft),
      opacity 140ms var(--ease-out-soft);
  }
  .buton-meniu[aria-expanded='true'] .bare i:first-child {
    transform: translateY(5.5px) rotate(45deg);
  }
  .buton-meniu[aria-expanded='true'] .bare i:nth-child(2) {
    opacity: 0;
  }
  .buton-meniu[aria-expanded='true'] .bare i:last-child {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  .meniu-mobil {
    border-top: 1px solid var(--color-rule);
    background: var(--color-paper);
    padding-block: 1rem 1.25rem;
    max-height: calc(100svh - var(--header-h) - 2.5rem);
    overflow-y: auto;
  }
  .meniu-mobil .shell {
    display: grid;
  }
  .mobil-cautare {
    margin-bottom: 1rem;
  }
  .mobil-link {
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-ink);
    text-decoration: none;
    font-size: 1.0625rem;
  }
  .mobil-link.activ {
    font-size: 1.2rem;
  }
  .mobil-titlu {
    margin: 1.5rem 0 0.25rem;
  }
  .mobil-accent {
    color: var(--color-accent-dark);
    font-weight: 600;
  }
  .mobil-sub {
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
  }
  .mobil-sub:last-child {
    border-bottom: 0;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<style is:global>
  html.meniu-deschis {
    overflow: hidden;
  }

  /* ── Insulele React din header — stiluri globale ───────────────── */
  .cos-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem 0.5rem 0.7rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: 8px;
    color: var(--color-ink);
    text-decoration: none;
    font-size: 0.875rem;
    line-height: 1;
    transition:
      border-color 160ms var(--ease-out-soft),
      background-color 160ms var(--ease-out-soft);
  }
  .cos-link:hover {
    border-color: var(--color-ink);
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
  }
  .cos-link .eticheta {
    display: none;
  }
  @media (min-width: 520px) {
    .cos-link .eticheta {
      display: inline;
    }
  }
  .cos-link .numar {
    font-size: 0.75rem;
    font-weight: 500;
    min-width: 1.35rem;
    height: 1.35rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--color-paper-deep);
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .cos-link .numar[data-plin='true'] {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  /* ── Căutare cu sugestii live ─────────────────────────────────── */
  .cautare {
    position: relative;
  }
  .cautare-camp {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.35rem 0 0.75rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: 10px;
    background: var(--color-paper-raised);
    transition: border-color 160ms var(--ease-out-soft);
  }
  .cautare-camp:focus-within {
    border-color: var(--color-ink);
  }
  .cautare-lupa {
    width: 18px;
    height: 18px;
    flex: none;
    color: var(--color-ink-faint);
  }
  .cautare-camp input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 0.68rem 0;
    font: inherit;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }
  .cautare-camp input:focus {
    outline: none;
  }
  .cautare-camp input::placeholder {
    color: var(--color-ink-faint);
  }
  .cautare-camp input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  .cautare-buton {
    flex: none;
    border: 0;
    border-radius: 7px;
    background: var(--color-ink);
    color: var(--color-paper);
    padding: 0.45rem 0.85rem;
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .cautare-buton:hover {
    background: #2e2820;
  }

  .cautare-panou {
    position: absolute;
    inset-inline: 0;
    top: calc(100% + 0.5rem);
    z-index: 60;
    background: var(--color-paper);
    border: 1px solid var(--color-rule-strong);
    border-radius: 10px;
    box-shadow: 0 22px 40px -20px rgb(23 20 15 / 0.35);
    overflow: hidden;
  }
  .cautare-lista {
    list-style: none;
    margin: 0;
    padding: 0.35rem;
  }
  .cautare-rand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
  }
  .cautare-rand.activ {
    background: var(--color-paper-deep);
  }
  .cautare-rand img {
    width: 44px;
    height: 55px;
    object-fit: cover;
    border-radius: 5px;
    background: #221f1c;
    flex: none;
  }
  .cautare-text {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }
  .cautare-nume {
    font-size: 1.0625rem;
  }
  .cautare-detaliu {
